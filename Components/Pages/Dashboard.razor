@page "/dashboard"

<PageTitle>SmartStock Dashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0">SmartStock Dashboard</h3>
            <p class="text-muted mb-0">Welcome back! Here's your inventory overview.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="RefreshData" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <text>Refreshing...</text>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    <text>Refresh</text>
                }
            </button>
                    </div>
    </div>
    
    <!-- Success/Error Messages -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <text>@successMessage</text>
            <button type="button" class="btn-close" @onclick="@(() => successMessage = "")"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <text>@errorMessage</text>
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
        </div>
    }
    
    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-package text-primary" style="font-size: 2.5rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Total Products</h6>
                            <h4 class="mb-0">@totalProducts</h4>
                            <small class="text-success">
                                @if (totalProducts > 0)
                                {
                                    <i class="bi bi-arrow-up"></i>
                                    <text>Active inventory</text>
                                }
                                else
                                {
                                    <text>No products yet</text>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100 @(lowStockItems > 0 ? "border-warning" : "")">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-exclamation-diamond @(lowStockItems > 0 ? "text-warning" : "text-success")" style="font-size: 2.5rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Low Stock Items</h6>
                            <h4 class="mb-0">@lowStockItems</h4>
                            <small class="@(lowStockItems > 0 ? "text-warning" : "text-success")">
                                @if (lowStockItems > 0)
                                {
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <text>Needs restocking</text>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle"></i>
                                    <text>All stocked</text>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-people text-success" style="font-size: 2.5rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Total Suppliers</h6>
                            <h4 class="mb-0">@totalSuppliers</h4>
                            <small class="text-success">
                                @if (totalSuppliers > 0)
                                {
                                    <i class="bi bi-people"></i>
                                    <text>Active partners</text>
                                }
                                else
                                {
                                    <text>No suppliers yet</text>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100 border-info" style="background: linear-gradient(135deg, #f8f9fa 0%, #e3f2fd 100%);">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="bi bi-wallet2 text-info" style="font-size: 2.5rem;"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0">Total Value</h6>
                            <h4 class="mb-0 text-info fw-bold">@totalValue.ToString("C")</h4>
                            <small class="text-info">
                                @if (totalValue > 0)
                                {
                                    <i class="bi bi-graph-up"></i>
                                    <text>Current inventory value</text>
                                }
                                else
                                {
                                    <text>No inventory value</text>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center mb-3">
                                <div class="me-3">
                                    <i class="bi bi-package text-primary" style="font-size: 1.8rem;"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">Product Management</h6>
                                    <p class="text-muted mb-0">Add products, manage stock levels, update pricing</p>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/products" class="btn btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i> Add Product
                                </a>
                                <a href="/products" class="btn btn-outline-primary">
                                    <i class="bi bi-list me-1"></i> View All Products
                                </a>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center mb-3">
                                <div class="me-3">
                                    <i class="bi bi-people text-success" style="font-size: 1.8rem;"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0">Supplier Management</h6>
                                    <p class="text-muted mb-0">Add suppliers, manage contact information</p>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/suppliers" class="btn btn-success">
                                    <i class="bi bi-plus-circle me-1"></i> Add Supplier
                                </a>
                                <a href="/suppliers" class="btn btn-outline-success">
                                    <i class="bi bi-list me-1"></i> View All Suppliers
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history me-2"></i>Recent Products
                    </h5>
                    <small class="text-muted">Latest @recentProducts.Count items</small>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted">Loading products...</p>
                        </div>
                    }
                    else if (recentProducts != null && recentProducts.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var product in recentProducts.Take(5))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 fw-bold">@product.ProductName</h6>
                                        <div class="d-flex gap-3 text-muted small">
                                            <span><i class="bi bi-box"></i> Stock: @product.QuantityInStock</span>
                                            <span><i class="bi bi-currency-dollar"></i> @product.UnitPrice.ToString("C")</span>
                                            <span><i class="bi bi-tag"></i> @product.Category</span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @if (product.QuantityInStock <= product.ReorderLevel)
                                        {
                                            <span class="badge bg-warning">
                                                <i class="bi bi-exclamation-triangle"></i> Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> In Stock
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        @if (recentProducts.Count > 5)
                        {
                            <div class="text-center mt-3">
                                <a href="/products" class="btn btn-sm btn-outline-primary">
                                    View all @recentProducts.Count products
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-package text-muted" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0 text-muted">No products found</p>
                            <a href="/products" class="btn btn-sm btn-primary mt-2">
                                <i class="bi bi-plus-circle me-1"></i> Add your first product
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>Recent Suppliers
                    </h5>
                    <small class="text-muted">Latest @recentSuppliers.Count partners</small>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2 mb-0 text-muted">Loading suppliers...</p>
                        </div>
                    }
                    else if (recentSuppliers != null && recentSuppliers.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var supplier in recentSuppliers.Take(5))
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1 fw-bold">@supplier.SupplierName</h6>
                                            <div class="d-flex gap-3 text-muted small">
                                                <span><i class="bi bi-person"></i> @supplier.ContactPerson</span>
                                                <span><i class="bi bi-telephone"></i> @supplier.PhoneNumber</span>
                                            </div>
                                            <div class="mt-1">
                                                <span class="badge bg-light text-dark">
                                                    <i class="bi bi-box"></i> @supplier.ProductSupplied
                                                </span>
                                            </div>
                                        </div>
                                        <a href="mailto:@supplier.Email" class="btn btn-sm btn-outline-primary" title="Email supplier">
                                            <i class="bi bi-envelope"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (recentSuppliers.Count > 5)
                        {
                            <div class="text-center mt-3">
                                <a href="/suppliers" class="btn btn-sm btn-outline-success">
                                    View all @recentSuppliers.Count suppliers
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-people text-muted" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0 text-muted">No suppliers found</p>
                            <a href="/suppliers" class="btn btn-sm btn-success mt-2">
                                <i class="bi bi-plus-circle me-1"></i> Add your first supplier
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalProducts = 0;
    private int lowStockItems = 0;
    private int totalSuppliers = 0;
    private decimal totalValue = 0;
    private List<Product> recentProducts = new List<Product>();
    private List<Supplier> recentSuppliers = new List<Supplier>();
    private bool isLoading = false;
    private string successMessage = "";
    private string errorMessage = "";

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
    
    [Inject]
    private ProductService productService { get; set; } = default!;
    
    [Inject]
    private SupplierService supplierService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    
    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            ClearMessages();

            // Load data from database
            var tasks = new[]
            {
                LoadProductsData(),
                LoadSuppliersData()
            };

            await Task.WhenAll(tasks);

            // Calculate statistics
            totalProducts = recentProducts.Count;
            lowStockItems = recentProducts.Count(p => p.QuantityInStock <= p.ReorderLevel);
            totalSuppliers = recentSuppliers.Count;
            totalValue = recentProducts.Sum(p => p.QuantityInStock * p.UnitPrice);

            if (totalProducts > 0 || totalSuppliers > 0)
            {
                successMessage = $"Dashboard loaded: {totalProducts} products, {totalSuppliers} suppliers";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading dashboard data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadProductsData()
    {
        try
        {
            recentProducts = await productService.GetAllProductsAsync();
        }
        catch (Exception ex)
        {
            throw new Exception($"Failed to load products: {ex.Message}");
        }
    }

    private async Task LoadSuppliersData()
    {
        try
        {
            recentSuppliers = await supplierService.GetAllSuppliersAsync();
        }
        catch (Exception ex)
        {
            throw new Exception($"Failed to load suppliers: {ex.Message}");
        }
    }

    private async Task RefreshData()
    {
        await LoadData();
        StateHasChanged();
    }

    private void ClearMessages()
    {
        successMessage = "";
        errorMessage = "";
    }
}
