@page "/suppliers"

<PageTitle>Supplier Transactions</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Supplier Transactions</h3>
        <div class="d-flex gap-2">
            <input class="form-control" type="text" placeholder="Search suppliers..." @bind="searchText" @oninput="PerformSearch" style="width: 200px;" />
            <button class="btn btn-warning" @onclick="SearchSupplier">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </div>
    
    <!-- Success/Error Messages -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            <text>@successMessage</text>
            <button type="button" class="btn-close" @onclick="@(() => successMessage = "")"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <text>@errorMessage</text>
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"></button>
        </div>
    }
    
    <!-- Input Form -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Supplier ID</label>
                            <input class="form-control" @bind="supplier.SupplierID" type="number" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Supplier Name *</label>
                            <input class="form-control" @bind="supplier.SupplierName" />
                            @if (validationErrors.ContainsKey("SupplierName"))
                            {
                                <small class="text-danger">@validationErrors["SupplierName"]</small>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact Person</label>
                            <input class="form-control" @bind="supplier.ContactPerson" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input class="form-control" @bind="supplier.PhoneNumber" />
                            @if (validationErrors.ContainsKey("PhoneNumber"))
                            {
                                <small class="text-danger">@validationErrors["PhoneNumber"]</small>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input class="form-control" @bind="supplier.Email" type="email" />
                            @if (validationErrors.ContainsKey("Email"))
                            {
                                <small class="text-danger">@validationErrors["Email"]</small>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Product Supplied</label>
                            <input class="form-control" @bind="supplier.ProductSupplied" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <textarea class="form-control" @bind="supplier.Address" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="d-flex gap-2">
                                <button class="btn btn-success" @onclick="AddSupplier" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <text>Adding...</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-plus-circle me-1"></i>
                                        <text>Add</text>
                                    }
                                </button>
                                <button class="btn btn-primary" @onclick="UpdateSupplier" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <text>Updating...</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-pencil-square me-1"></i>
                                        <text>Update</text>
                                    }
                                </button>
                                <button class="btn btn-info" @onclick="LoadSuppliers" disabled="@isLoading">
                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                    Refresh
                                </button>
                                <button class="btn btn-secondary" @onclick="ClearForm">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Data Grid -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (isLoading && suppliers.Count == 0)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading suppliers...</p>
                        </div>
                    }
                    else
                    {
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Supplier Name</th>
                                    <th>Contact Person</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Product Supplied</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (filteredSuppliers != null && filteredSuppliers.Any())
                                {
                                    @foreach (var supp in filteredSuppliers)
                                    {
                                        <tr>
                                            <td>@supp.SupplierID</td>
                                            <td>@supp.SupplierName</td>
                                            <td>@supp.ContactPerson</td>
                                            <td>@supp.PhoneNumber</td>
                                            <td>@supp.Email</td>
                                            <td>@supp.ProductSupplied</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectSupplier(supp)">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">No suppliers found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Supplier supplier = new Supplier();
    private List<Supplier> suppliers = new List<Supplier>();
    private List<Supplier> filteredSuppliers = new List<Supplier>();
    private string searchText = "";
    private string successMessage = "";
    private string errorMessage = "";
    private bool isLoading = false;
    private Dictionary<string, string> validationErrors = new Dictionary<string, string>();

    [Inject]
    private SupplierService supplierService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();
    }

    private async Task LoadSuppliers()
    {
        try
        {
            isLoading = true;
            suppliers = await supplierService.GetAllSuppliersAsync();
            filteredSuppliers = suppliers.ToList();
            ClearMessages();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading suppliers: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredSuppliers = suppliers.ToList();
        }
        else
        {
            filteredSuppliers = suppliers.Where(s => 
                s.SupplierID.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                s.SupplierName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                s.ContactPerson.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                s.ProductSupplied.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private async Task SearchSupplier()
    {
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            try
            {
                isLoading = true;
                suppliers = await supplierService.SearchSuppliersAsync(searchText);
                filteredSuppliers = suppliers.ToList();
                ClearMessages();
            }
            catch (Exception ex)
            {
                errorMessage = $"Error searching suppliers: {ex.Message}";
            }
            finally
            {
                isLoading = false;
            }
        }
        else
        {
            await LoadSuppliers();
        }
    }

    private bool ValidateSupplier()
    {
        validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(supplier.SupplierName))
        {
            validationErrors["SupplierName"] = "Supplier name is required";
        }

        if (!string.IsNullOrWhiteSpace(supplier.PhoneNumber) && !System.Text.RegularExpressions.Regex.IsMatch(supplier.PhoneNumber, @"^[\d\-\+\(\)\s]+$"))
        {
            validationErrors["PhoneNumber"] = "Invalid phone number format";
        }

        if (!string.IsNullOrWhiteSpace(supplier.Email) && !System.Text.RegularExpressions.Regex.IsMatch(supplier.Email, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            validationErrors["Email"] = "Invalid email format";
        }

        return validationErrors.Count == 0;
    }

    private async Task AddSupplier()
    {
        if (!ValidateSupplier())
        {
            return;
        }

        try
        {
            isLoading = true;
            var newSupplierId = await supplierService.InsertSupplierAsync(supplier);
            supplier.SupplierID = newSupplierId;
            
            suppliers.Add(supplier);
            filteredSuppliers = suppliers.ToList();
            
            successMessage = "Supplier added successfully!";
            await ClearForm();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error adding supplier: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateSupplier()
    {
        if (supplier.SupplierID == 0)
        {
            errorMessage = "Please select a supplier to update";
            return;
        }

        if (!ValidateSupplier())
        {
            return;
        }

        try
        {
            isLoading = true;
            var success = await supplierService.UpdateSupplierAsync(supplier);
            
            if (success)
            {
                var index = suppliers.FindIndex(s => s.SupplierID == supplier.SupplierID);
                if (index >= 0)
                {
                    suppliers[index] = supplier;
                    filteredSuppliers = suppliers.ToList();
                }
                
                successMessage = "Supplier updated successfully!";
            }
            else
            {
                errorMessage = "Supplier not found or update failed";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating supplier: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ClearForm()
    {
        supplier = new Inventory_Elederos_IT13.Models.Supplier();
        validationErrors.Clear();
        ClearMessages();
    }

    private void SelectSupplier(Inventory_Elederos_IT13.Models.Supplier selectedSupplier)
    {
        supplier = new Inventory_Elederos_IT13.Models.Supplier
        {
            SupplierID = selectedSupplier.SupplierID,
            SupplierName = selectedSupplier.SupplierName,
            ContactPerson = selectedSupplier.ContactPerson,
            PhoneNumber = selectedSupplier.PhoneNumber,
            Email = selectedSupplier.Email,
            Address = selectedSupplier.Address,
            ProductSupplied = selectedSupplier.ProductSupplied
        };
        validationErrors.Clear();
        ClearMessages();
    }

    private void ClearMessages()
    {
        successMessage = "";
        errorMessage = "";
    }
}
